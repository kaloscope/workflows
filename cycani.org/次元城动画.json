        "data": {
          "$schema": "script",
          "script": {
            "language": "python",
            "code": "import json\nimport math\n\n\ndef execute(node_id, node_data, context):\n    if context[\"cyc_status\"] != 200:\n        raise ValueError(f\"\u6b21\u5143\u57ce\u5217\u8868\u8bf7\u6c42\u5931\u8d25\uff1aHTTP {context['cyc_status']}\")\n    response = json.loads(context[\"cyc_response\"])\n    if response.get(\"code\") != 0 or not isinstance(response.get(\"data\"), dict):\n        raise ValueError(\"\u6b21\u5143\u57ce\u5217\u8868\u63a5\u53e3\u672a\u8fd4\u56de\u6709\u6548\u6570\u636e\")\n    data = response[\"data\"]\n    if not isinstance(data.get(\"list\"), list) or not data.get(\"pager\"):\n        raise ValueError(\"\u6b21\u5143\u57ce\u5217\u8868\u63a5\u53e3\u683c\u5f0f\u5df2\u53d8\u5316\")\n    pager = data[\"pager\"]\n    items = []\n    for item in data[\"list\"]:\n        items.append(\n            {\n                \"id\": \"/anime/\" + str(item[\"video_id\"]),\n                \"title\": item[\"title\"],\n                \"cover\": item.get(\"cover_url\", \"\"),\n                \"rating\": item.get(\"score\") or 0,\n                \"category\": \"\u5267\u573a\u756a\u7ec4\" if item.get(\"zone_id\") == 2 else \"TV\u756a\u7ec4\",\n                \"misc\": item.get(\"remarks\")\n                or \" / \".join(\n                    str(item[k]) for k in (\"year\", \"area\", \"version\") if item.get(k)\n                ),\n            }\n        )\n    context[\"cyc_result\"] = json.dumps(\n        {\n            \"page\": pager[\"page\"],\n            \"total\": pager[\"total\"],\n            \"totalPages\": max(1, math.ceil(pager[\"total\"] / pager[\"page_size\"])),\n            \"items\": items,\n        },\n        ensure_ascii=False,\n    )\n"
          }
        },
        "origin": [
