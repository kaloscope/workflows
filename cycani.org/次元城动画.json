            "code": "import json\n\n\ndef execute(node_id, node_data, context):\n    if context[\"cyc_status\"] != 200:\n        raise ValueError(f\"\u6b21\u5143\u57ce\u8be6\u60c5\u8bf7\u6c42\u5931\u8d25\uff1aHTTP {context['cyc_status']}\")\n    response = json.loads(context[\"cyc_response\"])\n    detail = response.get(\"data\")\n    if response.get(\"code\") != 0 or not isinstance(detail, dict):\n        raise ValueError(\"\u6b21\u5143\u57ce\u8be6\u60c5\u63a5\u53e3\u672a\u8fd4\u56de\u6709\u6548\u6570\u636e\")\n    context[\"cyc_detail\"] = json.dumps(detail, ensure_ascii=False)\n    tasks = [\n        {\n            \"code\": source[\"code\"],\n            \"title\": source.get(\"title\") or source[\"code\"],\n            \"page\": 1,\n        }\n        for source in detail.get(\"play_from\", [])\n        if source.get(\"code\")\n    ]\n    context[\"cyc_section_tasks\"] = json.dumps(tasks, ensure_ascii=False)\n    context[\"cyc_section_requests\"] = len(tasks)\n    context[\"cyc_chapters\"] = \"[]\"\n"
