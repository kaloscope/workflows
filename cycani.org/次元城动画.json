        "data": {
          "$schema": "script",
          "script": {
            "language": "python",
            "code": "from urllib.parse import urlencode\n\n\ndef execute(node_id, node_data, context):\n    page = max(1, int(context.get(\"page_num\") or 1))\n    size = min(100, max(1, int(context.get(\"page_size\") or 48)))\n    channel = str(context.get(\"channel\") or \"20\")\n    zone = {\"20\": 1, \"21\": 2, \"1\": 1, \"2\": 2}.get(channel, 1)\n    query = {\"page\": page, \"page_size\": size, \"zone_id\": zone}\n    keyword = str(context.get(\"keyword\") or \"\").strip()\n    path = \"/videos\"\n    if keyword:\n        path += \"/search\"\n        query[\"q\"] = keyword\n    else:\n        query[\"order_by\"] = {\n            \"time\": \"update_time\",\n            \"hits\": \"hits\",\n            \"score\": \"score\",\n        }.get(context.get(\"by\"), \"update_time\")\n        for field, parameter in ((\"class\", \"tag\"), (\"year\", \"year\")):\n            value = str(context.get(field) or \"\").strip()\n            if value and value not in (\"all\", \"\u5168\u90e8\"):\n                query[parameter] = value\n    context[\"cyc_list_url\"] = (\n        \"https://www.cycani.org/api\" + path + \"?\" + urlencode(query)\n    )\n"
          }
        },
