        "data": {
          "$schema": "script",
          "script": {
            "language": "python",
            "code": "import json\nimport re\n\n\ndef execute(node_id, node_data, context):\n    detail = json.loads(context[\"cyc_detail\"])\n    chapters = json.loads(context[\"cyc_chapters\"])\n    selected = str(context.get(\"chapter_id\") or \"\")\n    chapter = next((c for c in chapters if c[\"id\"] == selected), None)\n    if selected and chapter is None:\n        raise ValueError(\"\u6b21\u5143\u57ce\u9009\u96c6\u5df2\u53d8\u5316\uff0c\u8bf7\u91cd\u65b0\u6253\u5f00\u756a\u5267\")\n    chapter = chapter or (chapters[0] if chapters else None)\n    result = {\n        \"id\": chapter[\"id\"] if chapter else f\"/anime/{detail['id']}\",\n        \"title\": detail[\"title\"] + (\" \u00b7 \" + chapter[\"title\"] if chapter else \"\"),\n        \"cover\": detail.get(\"cover_url\", \"\"),\n        \"category\": \"\u5267\u573a\u756a\u7ec4\" if detail.get(\"zone_id\") == 2 else \"TV\u756a\u7ec4\",\n        \"chapters\": chapters,\n        \"media_type\": \"text\",\n        \"text\": detail.get(\"description\", \"\"),\n    }\n    auth = context.get(\"$auth\") or {}\n    token = str(auth.get(\"token\") or \"\").strip() if isinstance(auth, dict) else \"\"\n    token = re.sub(r\"^Bearer\\s+\", \"\", token, flags=re.IGNORECASE).strip()\n    context[\"cyc_token\"] = token\n    context[\"cyc_can_play\"] = bool(chapter and token)\n    context[\"cyc_section_id\"] = chapter[\"id\"] if chapter else \"\"\n    if not token:\n        result[\"text\"] = (\n            \"\u6b21\u5143\u57ce\u64ad\u653e\u9700\u8981\u767b\u5f55\u3002\\n\\n\"\n            \"\u8bf7\u8fd4\u56de\u300c\u6b21\u5143\u57ce\u52a8\u753b\u300d\u641c\u7d22\u9875\uff0c\u70b9\u51fb\u53f3\u4e0a\u89d2\u7684\u300c\u767b\u5f55\u300d\uff0c\"\n            \"\u4f7f\u7528\u4f60\u7684\u6b21\u5143\u57ce\u8d26\u53f7\u767b\u5f55\u540e\u91cd\u65b0\u6253\u5f00\u756a\u5267\u3002\"\n        )\n    elif not chapter:\n        result[\"text\"] = \"\u672c\u756a\u5267\u6682\u65f6\u6ca1\u6709\u53ef\u64ad\u653e\u7684\u9009\u96c6\u3002\\n\\n\" + result[\"text\"]\n    context[\"cyc_result\"] = json.dumps(result, ensure_ascii=False)\n"
          }
        },
