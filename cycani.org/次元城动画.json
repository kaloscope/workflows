        "position": {
          "x": 1560,
          "y": 90
        },
        "data": {
          "$schema": "script",
          "script": {
            "language": "python",
            "code": "import json\nimport time\nfrom datetime import UTC, datetime\n\n\ndef execute(node_id, node_data, context):\n    context[\"cyc_auth_result\"] = json.dumps({\"name\": None})\n    try:\n        response = json.loads(context[\"cyc_response\"])\n    except ValueError:\n        return\n    data = response.get(\"data\") or {}\n    if (\n        context[\"cyc_status\"] != 200\n        or response.get(\"code\") != 0\n        or not isinstance(data, dict)\n        or not data.get(\"token\")\n    ):\n        return\n    expires_in = 3600\n    if data.get(\"expires_at\"):\n        try:\n            expiry = data[\"expires_at\"]\n            if isinstance(expiry, (int, float)):\n                expires_in = int(expiry - time.time())\n            else:\n                expiry = datetime.fromisoformat(str(expiry).replace(\"Z\", \"+00:00\"))\n                if expiry.tzinfo is None:\n                    expiry = expiry.replace(tzinfo=UTC)\n                expires_in = int(expiry.timestamp() - time.time())\n        except (TypeError, ValueError):\n            return\n    elif data.get(\"expires_in\") is not None:\n        try:\n            expires_in = int(data[\"expires_in\"])\n        except (TypeError, ValueError):\n            return\n    if expires_in <= 0:\n        return\n    user = data.get(\"user\") or {}\n    name = user.get(\"nickname\") or user.get(\"username\") or context.get(\"username\")\n    if not name:\n        return\n    context[\"cyc_auth_result\"] = json.dumps(\n        {\"name\": name, \"token\": data[\"token\"], \"expires_in\": expires_in},\n        ensure_ascii=False,\n    )\n"
          }
        },
        "origin": [
          0.5,
          0
        ]
      },
