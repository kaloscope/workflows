        "data": {
          "$schema": "script",
          "script": {
            "language": "python",
            "code": "import json\nfrom urllib.parse import urlsplit\n\n\ndef execute(node_id, node_data, context):\n    result = json.loads(context[\"cyc_result\"])\n    try:\n        response = json.loads(context[\"cyc_response\"])\n    except ValueError:\n        response = {}\n    data = response.get(\"data\") or {}\n    url = data.get(\"url\") or \"\" if isinstance(data, dict) else \"\"\n    context[\"cyc_auth_invalid\"] = context[\"cyc_status\"] == 401 or response.get(\n        \"code\"\n    ) in (401, 1001, 1002)\n    if context[\"cyc_auth_invalid\"]:\n        result[\"text\"] = (\n            \"\u6b21\u5143\u57ce\u767b\u5f55\u5df2\u5931\u6548\u3002\u8bf7\u8fd4\u56de\u300c\u6b21\u5143\u57ce\u52a8\u753b\u300d\u641c\u7d22\u9875\uff0c\"\n            \"\u70b9\u51fb\u300c\u767b\u5f55\u300d\u91cd\u65b0\u767b\u5f55\u540e\u518d\u64ad\u653e\u3002\"\n        )\n    elif context[\"cyc_status\"] == 403 or response.get(\"code\") == 403:\n        result[\"text\"] = \"\u6b21\u5143\u57ce\u62d2\u7edd\u4e86\u672c\u6b21\u64ad\u653e\uff0c\u8bf7\u786e\u8ba4\u5f53\u524d\u7f51\u7edc\u548c\u8d26\u53f7\u53ef\u4ee5\u5728\u5b98\u7f51\u64ad\u653e\u3002\"\n    elif context[\"cyc_status\"] != 200 or response.get(\"code\") != 0 or not url:\n        result[\"text\"] = \"\u6b21\u5143\u57ce\u6682\u672a\u8fd4\u56de\u64ad\u653e\u5730\u5740\uff0c\u8bf7\u7a0d\u540e\u91cd\u8bd5\u6216\u5728\u5b98\u7f51\u68c0\u67e5\u8be5\u9009\u96c6\u3002\"\n    elif urlsplit(url).scheme not in (\"http\", \"https\"):\n        result[\"text\"] = \"\u6b21\u5143\u57ce\u8fd4\u56de\u4e86\u4e0d\u652f\u6301\u7684\u64ad\u653e\u5730\u5740\u3002\"\n    else:\n        path = urlsplit(url).path.lower()\n        video_type = (\n            \"hls\" if \".m3u8\" in path else \"flv\" if path.endswith(\".flv\") else \"mp4\"\n        )\n        result.pop(\"text\", None)\n        result.update(\n            {\n                \"media_type\": \"video\",\n                \"video_type\": video_type,\n                \"url\": url,\n                \"definitions\": [\n                    {\"url\": url, \"definition\": data.get(\"name\") or \"\u9ed8\u8ba4\u7ebf\u8def\"}\n                ],\n                \"danmakus\": [],\n            }\n        )\n    context[\"cyc_result\"] = json.dumps(result, ensure_ascii=False)\n"
          }
        },
