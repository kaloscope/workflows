        "data": {
          "$schema": "script",
          "script": {
            "language": "python",
            "code": "import json\n\n\ndef execute(node_id, node_data, context):\n    if context[\"cyc_status\"] != 200:\n        raise ValueError(f\"\u6b21\u5143\u57ce\u9009\u96c6\u8bf7\u6c42\u5931\u8d25\uff1aHTTP {context['cyc_status']}\")\n    response = json.loads(context[\"cyc_response\"])\n    data = response.get(\"data\")\n    if response.get(\"code\") != 0 or not isinstance(data, dict):\n        raise ValueError(\"\u6b21\u5143\u57ce\u9009\u96c6\u63a5\u53e3\u672a\u8fd4\u56de\u6709\u6548\u6570\u636e\")\n    if not isinstance(data.get(\"list\"), list) or not data.get(\"pager\"):\n        raise ValueError(\"\u6b21\u5143\u57ce\u9009\u96c6\u63a5\u53e3\u683c\u5f0f\u5df2\u53d8\u5316\")\n    tasks = json.loads(context[\"cyc_section_tasks\"])\n    task = tasks[context[\"cyc_section_index\"]]\n    chapters = json.loads(context[\"cyc_chapters\"])\n    multiple = len({t[\"code\"] for t in tasks}) > 1\n    known = {c[\"id\"] for c in chapters}\n    for item in data[\"list\"]:\n        identifier = str(item[\"id\"])\n        if identifier not in known:\n            title = item.get(\"title\") or identifier\n            chapters.append(\n                {\n                    \"id\": identifier,\n                    \"title\": f\"{task['title']} \u00b7 {title}\" if multiple else title,\n                }\n            )\n            known.add(identifier)\n    pager = data[\"pager\"]\n    if pager[\"page\"] * pager[\"page_size\"] < pager[\"total\"]:\n        if not data[\"list\"]:\n            raise ValueError(\"\u6b21\u5143\u57ce\u9009\u96c6\u5206\u9875\u8fd4\u56de\u7a7a\u9875\uff0c\u8bf7\u7a0d\u540e\u91cd\u8bd5\")\n        tasks.insert(\n            context[\"cyc_section_index\"] + 1, {**task, \"page\": pager[\"page\"] + 1}\n        )\n    context[\"cyc_chapters\"] = json.dumps(chapters, ensure_ascii=False)\n    context[\"cyc_section_tasks\"] = json.dumps(tasks, ensure_ascii=False)\n    context[\"cyc_section_requests\"] = len(tasks)\n"
