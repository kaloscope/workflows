            "code": "import re\n\n\ndef execute(node_id, node_data, context):\n    identifier = str(context.get(\"id\") or \"\").strip(\"/\")\n    match = re.fullmatch(r\"(?:anime/)?([1-9]\\d*)\", identifier)\n    if not match:\n        raise ValueError(\"\u6b21\u5143\u57ce\u8d44\u6e90\u5730\u5740\u5df2\u53d8\u5316\uff0c\u8bf7\u4ece\u65b0\u7248\u641c\u7d22\u7ed3\u679c\u91cd\u65b0\u6253\u5f00\")\n    context[\"cyc_video_id\"] = int(match.group(1))\n"
